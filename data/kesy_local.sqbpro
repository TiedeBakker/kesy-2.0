<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="C:\TB-Projecten\toolbox\kesy-2.0\data\kesy_local.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="125"/><column_width id="3" width="2523"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><current_table name="4,14:mainrelevante_taxa"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="object_types" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="52"/><column index="2" value="52"/><column index="3" value="109"/><column index="4" value="102"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="objects" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="300"/><column index="2" value="619"/><column index="3" value="137"/><column index="4" value="209"/><column index="5" value="80"/><column index="6" value="209"/><column index="7" value="102"/></column_widths><filter_values><column index="2" value="kast"/></filter_values><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="parameter_sets" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="300"/><column index="2" value="226"/><column index="3" value="209"/><column index="4" value="102"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="parameter_values" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="300"/><column index="2" value="398"/><column index="3" value="314"/><column index="4" value="111"/><column index="5" value="1017"/><column index="6" value="137"/><column index="7" value="209"/><column index="8" value="80"/><column index="9" value="209"/><column index="10" value="102"/></column_widths><filter_values><column index="2" value="019fd14a-991d-7265-b929-8da2ee294507"/></filter_values><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="parameters" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="300"/><column index="2" value="279"/><column index="3" value="167"/><column index="4" value="97"/><column index="5" value="52"/><column index="6" value="209"/><column index="7" value="102"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="relation_values" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="300"/><column index="2" value="300"/><column index="3" value="300"/><column index="4" value="300"/><column index="5" value="86"/><column index="6" value="137"/><column index="7" value="209"/><column index="8" value="80"/><column index="9" value="209"/><column index="10" value="102"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="relations" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="378"/><column index="2" value="201"/><column index="3" value="209"/><column index="4" value="102"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="relevante_taxa" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="300"/><column index="2" value="300"/><column index="3" value="110"/><column index="4" value="124"/><column index="5" value="133"/><column index="6" value="300"/><column index="7" value="245"/><column index="8" value="178"/><column index="9" value="299"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">Select objects.label AS Header1, objects.id AS Id1, relation_values.target_id AS Id2 from objects join relation_values on relation_values.source_id = objects.id where objects.label like '%kastenwand%' ORDER by relation_values.volgorde;
</sql><sql name="SQL 2">select * from objects left join (SELECT * FROM parameter_values WHERE parameter_id = '019fc74c-cf8c-74ff-a3b6-b6d21c651a19') AS p on objects.id = p.target_id where label = 'Wijnhof'</sql><sql name="SQL 3">WITH RECURSIVE object_tree(id, niveau) AS (

    -- Start: de kastenwand
    SELECT
        '019fa8b8-11c7-72fb-90c1-2ae9b9476dc1',
        0

    UNION ALL

    -- Volgende niveaus
    SELECT
        rv.target_id,
        ot.niveau + 1
    FROM object_tree ot
    JOIN relation_values rv
        ON rv.source_id = ot.id
    WHERE rv.deleted_at IS NULL
)

SELECT
    ot.niveau,
    ot.id,
    o.label
FROM object_tree ot
JOIN objects o
    ON o.id = ot.id
WHERE o.deleted_at IS NULL
ORDER BY ot.niveau, o.label;</sql><sql name="SQL 4">WITH RECURSIVE object_tree(id) AS (

    SELECT
        '019fa8b8-11c7-72fb-90c1-2ae9b9476dc1'

    UNION

    SELECT
        rv.target_id
    FROM object_tree ot
    JOIN relation_values rv
        ON rv.source_id = ot.id
    WHERE rv.deleted_at IS NULL
)

SELECT

    SUM(
        CASE
            WHEN pv.parameter_id =
                '019fad6f-c149-7795-b3e5-751c8b2b7949'
            THEN CAST(pv.value AS INTEGER)
            ELSE 0
        END
    ) AS totaal_aantal_insecten,

    COUNT(
        DISTINCT CASE
            WHEN pv.parameter_id =
                '019fce6b-626f-7609-b67c-17fb251e36e7'
            THEN pv.value
        END
    ) AS aantal_soorten

FROM object_tree ot
JOIN parameter_values pv
    ON pv.target_id = ot.id
   AND pv.target_type = 'object'
WHERE pv.deleted_at IS NULL;</sql><sql name="SQL 5">WITH RECURSIVE object_tree(id, niveau) AS (

    SELECT
        '019fa8b8-11c7-72fb-90c1-2ae9b9476dc1',
        0

    UNION

    SELECT
        rv.target_id,
        ot.niveau + 1
    FROM object_tree ot
    JOIN relation_values rv
        ON rv.source_id = ot.id
    WHERE rv.deleted_at IS NULL
)

SELECT
    pv.target_type,
    p.label AS parameter,
    pv.value,
    COUNT(*) AS aantal_keer

FROM object_tree ot

JOIN parameter_values pv
    ON pv.target_id = ot.id

JOIN parameters p
    ON p.id = pv.parameter_id

WHERE pv.deleted_at IS NULL
  AND pv.parameter_id IN (
      '019fad6f-c149-7795-b3e5-751c8b2b7949',
      '019fce6b-626f-7609-b67c-17fb251e36e7'
  )

GROUP BY
    pv.target_type,
    p.label,
    pv.value

ORDER BY
    p.label,
    pv.value;</sql><sql name="SQL 6">WITH RECURSIVE object_tree(id) AS (

    SELECT
        '019fa8b8-11c7-72fb-90c1-2ae9b9476dc1'

    UNION

    SELECT
        rv.target_id
    FROM object_tree ot
    JOIN relation_values rv
        ON rv.source_id = ot.id
    WHERE rv.deleted_at IS NULL
)

SELECT
    SUM(
        CASE
            WHEN p.label = 'Aantal'
            THEN CAST(pv.value AS INTEGER)
            ELSE 0
        END
    ) AS totaal_aantal_insecten,

    COUNT(
        DISTINCT CASE
            WHEN p.label = 'Gegeven Taxon-naam'
            THEN pv.value
        END
    ) AS aantal_soorten

FROM object_tree ot

JOIN parameter_values pv
    ON pv.target_id = ot.id
   AND pv.target_type = 'object'

JOIN parameters p
    ON p.id = pv.parameter_id

WHERE pv.deleted_at IS NULL;</sql><sql name="SQL 7">WITH RECURSIVE object_tree(id, kast_id) AS (

    -- Niveau 1: de kasten die direct onder de kastenwand hangen
    SELECT
        rv.target_id,
        rv.target_id
    FROM relation_values rv
    WHERE rv.source_id =
        '019fa8b8-11c7-72fb-90c1-2ae9b9476dc1'
      AND rv.deleted_at IS NULL

    UNION

    -- Alle onderliggende niveaus
    SELECT
        rv.target_id,
        ot.kast_id
    FROM object_tree ot
    JOIN relation_values rv
        ON rv.source_id = ot.id
    WHERE rv.deleted_at IS NULL
)

SELECT
    kast.label AS kastnaam,

    SUM(
        CASE
            WHEN p.label = 'Aantal'
            THEN CAST(pv.value AS INTEGER)
            ELSE 0
        END
    ) AS aantal_insecten,

    COUNT(
        DISTINCT CASE
            WHEN p.label = 'Gegeven Taxon-naam'
            THEN pv.value
        END
    ) AS aantal_taxa

FROM object_tree ot

JOIN objects kast
    ON kast.id = ot.kast_id

JOIN parameter_values pv
    ON pv.target_id = ot.id
   AND pv.target_type = 'object'

JOIN parameters p
    ON p.id = pv.parameter_id

WHERE pv.deleted_at IS NULL
  AND p.label IN ('Aantal', 'Gegeven Taxon-naam')

GROUP BY
    kast.id,
    kast.label

ORDER BY
    kast.label;</sql><sql name="SQL 8">WITH RECURSIVE object_tree(id, kast_id, niveau) AS (

    -- Niveau 1: de kasten
    SELECT
        rv.target_id,
        rv.target_id,
        1
    FROM relation_values rv
    WHERE rv.source_id =
        '019fa8b8-11c7-72fb-90c1-2ae9b9476dc1'
      AND rv.deleted_at IS NULL

    UNION

    -- Onderliggende niveaus
    SELECT
        rv.target_id,
        ot.kast_id,
        ot.niveau + 1
    FROM object_tree ot
    JOIN relation_values rv
        ON rv.source_id = ot.id
    WHERE rv.deleted_at IS NULL
)

SELECT
    kast.label AS kastnaam,
    ot.niveau,
    o.label AS objectnaam,
    p.label AS parameter,
    pv.value

FROM object_tree ot

JOIN objects kast
    ON kast.id = ot.kast_id

JOIN objects o
    ON o.id = ot.id

JOIN parameter_values pv
    ON pv.target_id = ot.id
   AND pv.target_type = 'object'

JOIN parameters p
    ON p.id = pv.parameter_id

WHERE pv.deleted_at IS NULL
  AND p.label IN ('Aantal', 'Gegeven Taxon-naam')

ORDER BY
    kast.label,
    ot.niveau,
    o.label,
    p.label;</sql><sql name="SQL 9">DELETE FROM relevante_taxa</sql><current_tab id="8"/></tab_sql></sqlb_project>
